{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jeccam Edu",
  "version": "0.1.2",
  "identifier": "com.jeccamtech.ecole",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop",
    "devUrl": "http://localhost:3000/login",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jeccam École",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "url": "/login"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwMDhCN0YzMjgwNDZGQzIKUldUQ2J3UW84N2NJa0oybzJzbGpwS21DRVZiSUZSUFlFTjZ3U3pBQW9Bd0loc21VNFA1bnJJVnkK",
      "endpoints": [
        "https://ecole.jeccamtech.com/updates/latest.json"
      ]
    }
  }
}
