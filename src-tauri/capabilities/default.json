{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions par défaut de la fenêtre principale — accès SQLite local restreint à notre base, mises à jour et redémarrage.",
  "windows": ["main"],
  "permissions": [
    "core:default",

    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",

    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",

    "process:allow-restart"
  ]
}
